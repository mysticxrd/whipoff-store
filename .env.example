# Whipoff store — environment. Copy to .env.local and fill in.
# Slice 0 boots green with placeholders; real values arrive at cloud-wiring time.

# ── Supabase (required) ──────────────────────────────────────────────
# Project URL + anon (publishable) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key is used ONLY from the payments slice (Stripe webhook) and MUST stay
# server-side — never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Razorpay (payments slice — cards + UPI) ──────────────────────────
# TEST-MODE only (payments.md): the rzp_test_ prefix on the KEY ID is enforced by Zod — a
# live key id fails env validation by design until the verify gate + explicit approval flips
# it. The key id is the ONLY Razorpay value allowed in the client bundle (the browser needs
# it to open Standard Checkout; it grants nothing without the server-side secret).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key-id
# Key secret + webhook signing secret are server-only — never NEXT_PUBLIC_, never committed.
# (Razorpay key secrets are unprefixed random strings; the webhook secret is the one you type
# when creating the webhook in the Razorpay Dashboard.)
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Email (Resend — Slice 5) ─────────────────────────────────────────
# Server-only (never NEXT_PUBLIC_), re_ prefix enforced by Zod. OPTIONAL: leave empty and the
# webhook records confirmation emails as skipped ("not_configured") — orders are never blocked
# by email (failure isolation). Sandbox posture: with the placeholder sender below, Resend
# delivers only to the account owner's inbox — the verified `orders@…` domain sender is an
# explicitly-approved 04_ship step (mirrors Stripe live keys).
RESEND_API_KEY=
EMAIL_FROM="Whipoff <onboarding@resend.dev>"

# ── Analytics (optional) ─────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA4_ID=

# ── Monitoring (optional) ────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

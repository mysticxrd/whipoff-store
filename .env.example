# Whipoff store environment. Copy to .env.local and fill in.
# Slice 0 boots green with placeholders; real values arrive at cloud-wiring time.

# -- Supabase (required) -----------------------------------------------------
# Project URL + anon (publishable) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key is used only by payments and must stay server-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- Razorpay (cards + UPI) --------------------------------------------------
# Strict deployment separation: the key ID is public, but Vercel Production requires rzp_live_.
# Preview, local, and test environments require rzp_test_. A mismatched or incomplete selected
# pair fails before checkout staging or a provider call.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key-id
# Non-Production (local / Preview / test) only. Server-only; never NEXT_PUBLIC_ or committed.
RAZORPAY_TEST_KEY_SECRET=your-razorpay-test-key-secret
RAZORPAY_TEST_WEBHOOK_SECRET=your-razorpay-test-webhook-secret
# Production only: configure these in Vercel's Production scope together with an rzp_live_ key.
# Do not put live credentials in a local file, Preview scope, source control, or an rzp_test_
# deployment.
# RAZORPAY_LIVE_KEY_SECRET=your-razorpay-live-key-secret
# RAZORPAY_LIVE_WEBHOOK_SECRET=your-razorpay-live-webhook-secret

# -- Email (Resend) ----------------------------------------------------------
# Server-only and optional. With the placeholder sender, Resend's sandbox delivers only to the
# account owner until a verified domain is explicitly approved at Stage 04.
RESEND_API_KEY=
EMAIL_FROM="Whipoff <onboarding@resend.dev>"

# -- Analytics (optional) ----------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA4_ID=

# -- Monitoring (optional) ---------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# Whipoff store — environment. Copy to .env.local and fill in.
# Slice 0 boots green with placeholders; real values arrive at cloud-wiring time.

# ── Supabase (required) ──────────────────────────────────────────────
# Project URL + anon (publishable) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key is used ONLY from the payments slice (Stripe webhook) and MUST stay
# server-side — never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe (payments slice) ──────────────────────────────────────────
# TEST-MODE keys only (payments.md): pk_test_/sk_test_ are enforced by Zod — a live key
# fails env validation by design until the verify gate + explicit approval flips it.
# Publishable key is the ONLY Stripe value allowed in the client bundle.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# Secret + webhook signing secret are server-only — never NEXT_PUBLIC_, never committed.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# ── Analytics (optional) ─────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA4_ID=

# ── Monitoring (optional) ────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
